{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "paths": {
      "@hraness/ui": [
        "./src/index.ts"
      ]
    },
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "build/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/build-package.ts",
    "scripts/check-committed-dist.test.ts",
    "scripts/gallery-browser.ts",
    "scripts/next-dev-adopter-smoke.ts",
    "scripts/next-dev-diagnostics.test.ts",
    "scripts/next-dev-inputs.test.ts",
    "scripts/next-dev-network.test.ts",
    "scripts/next-dev-restart.test.ts",
    "scripts/vite8-adopter-smoke.ts",
    "scripts/vite8-adopter-custody.test.ts",
    "scripts/vite8-adopter-custody.process.test.ts",
    "fixtures/vite8-adopter/custody.ts",
    "fixtures/vite8-adopter/diagnostics.ts",
    "fixtures/vite8-adopter/cancellation-owner.ts",
    "gallery/**/*.ts",
    "gallery/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx"
  ]
}
