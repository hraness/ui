{
  "name": "@hraness/ui",
  "version": "0.4.10",
  "description": "Accessible product-neutral React Aria primitives with compiled StyleX recipes and portable CSS tokens.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/stylex.css",
    "./src/components.css",
    "./src/index.ts",
    "./src/reset.css",
    "./src/styles.css",
    "./src/tailwind.css",
    "./src/tokens.css"
  ],
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/ui.git"
  },
  "homepage": "https://github.com/hraness/ui#readme",
  "bugs": {
    "url": "https://github.com/hraness/ui/issues"
  },
  "keywords": [
    "react",
    "react-aria",
    "stylex",
    "tailwindcss",
    "components",
    "accessibility"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./components.css": "./src/components.css",
    "./reset.css": "./src/reset.css",
    "./styles.css": "./src/styles.css",
    "./stylex.css": "./dist/stylex.css",
    "./tailwind.css": "./src/tailwind.css",
    "./tokens.css": "./src/tokens.css"
  },
  "style": "./src/styles.css",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src/ask-ai.stylex.ts",
    "src/ask-ai.tsx",
    "src/actions.stylex.ts",
    "src/actions.tsx",
    "src/autocomplete.tsx",
    "src/avatar.stylex.ts",
    "src/badge.tsx",
    "src/card.stylex.ts",
    "src/card.tsx",
    "src/checkbox-field.stylex.ts",
    "src/checkbox-group.tsx",
    "src/collections.stylex.ts",
    "src/collections.tsx",
    "src/components.css",
    "src/content.stylex.ts",
    "src/content.tsx",
    "src/data-table.stylex.ts",
    "src/data-display.tsx",
    "src/feedback.stylex.ts",
    "src/feedback.tsx",
    "src/fields.stylex.ts",
    "src/fields.tsx",
    "src/form.stylex.ts",
    "src/form.tsx",
    "src/icon.stylex.ts",
    "src/icon.tsx",
    "src/index.ts",
    "src/indicators.stylex.ts",
    "src/indicators.tsx",
    "src/key-hint.stylex.ts",
    "src/knob-model.ts",
    "src/knob.stylex.ts",
    "src/knob.tsx",
    "src/lib/stylex.ts",
    "src/lib/utils.ts",
    "src/list-box.tsx",
    "src/navigation.tsx",
    "src/overlays.tsx",
    "src/quiet-site.stylex.ts",
    "src/quiet-site.tsx",
    "src/reset.css",
    "src/router.tsx",
    "src/select-field.stylex.ts",
    "src/select-field.tsx",
    "src/separator.stylex.ts",
    "src/skip-link.stylex.ts",
    "src/skip-link.tsx",
    "src/status.stylex.ts",
    "src/styles.css",
    "src/surfaces.stylex.ts",
    "src/surfaces.tsx",
    "src/tailwind.css",
    "src/toast.tsx",
    "src/tokens.css",
    "src/toolbar.stylex.ts",
    "src/toolbar.tsx",
    "src/visually-hidden.stylex.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run ./scripts/build-package.ts && bun run ./scripts/mark-react-client-package.ts",
    "check:committed-dist": "bun run ./scripts/check-committed-dist.ts",
    "check:portfolio-inventory": "bun ./scripts/check-portfolio-inventory.ts",
    "check:stylex-artifacts": "bun run ./scripts/check-stylex-artifacts.ts",
    "check:stylex-determinism": "bun run ./scripts/check-stylex-determinism.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./scripts/register-stylex-test-transform.ts ./src ./scripts/check-committed-dist.test.ts ./scripts/package-consumer-lifecycle.test.ts",
    "test:browser": "bun run ./scripts/gallery-browser.ts",
    "test:package": "bun run ./scripts/package-smoke.ts",
    "test:packed-bun-browser": "bun run ./scripts/packed-bun-browser-smoke.ts",
    "kb:refresh": "bunx --bun github:hraness/kb#v0.15.1 refresh --root kb",
    "kb:check:lane": "bunx --bun github:hraness/kb#v0.15.1 check --root kb --no-catalog",
    "kb:check": "bunx --bun github:hraness/kb#v0.15.1 check --root kb && bunx --bun github:hraness/kb#v0.15.1 agents check --root kb --repo .",
    "kb:catalog": "bunx --bun github:hraness/kb#v0.15.1 catalog --root kb",
    "check": "bun run check:portfolio-inventory && bun run typecheck && bun run build && bun run check:committed-dist && bun run check:stylex-artifacts && bun run check:stylex-determinism && bun run test:package && bun run test:packed-bun-browser && bun run test && bun run test:browser",
    "prepack": "bun run check"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@stylexjs/stylex": "0.19.0",
    "clsx": "^2.1.1",
    "react-aria": "3.50.0",
    "react-aria-components": "1.19.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright-core": "1.62.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^6.0.3",
    "unplugin": "2.3.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
